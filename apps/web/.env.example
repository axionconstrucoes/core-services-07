# NEXT_PUBLIC_ACC_TEST_MODE
# Controla a etiqueta global "SISTEMA EM TESTE" exibida no topo de
# todas as páginas do ACC (incluindo /login).
#
# Regra fail-safe: só se esconde com o valor EXATO "false". Ausente,
# vazio, "true" ou qualquer outro valor sempre mostra a etiqueta.
#
# NEXT_PUBLIC_ACC_TEST_MODE=false

# ACC_OUTBOUND_MODE / ACC_PILOT_RECIPIENT (server-only — nunca
# NEXT_PUBLIC_*, nunca expostas ao navegador)
#
# Trava global de e-mail do piloto — garante que nenhuma mensagem
# enviada pelo ACC (Gmail real ou FakeEmailProvider) chegue a um
# destinatário original enquanto o piloto estiver ativo. Aplicada
# dentro de GmailEmailProvider e FakeEmailProvider — não depende de
# nenhum fluxo de negócio individual se lembrar de configurá-la.
#
# Regra fail-closed: somente o valor EXATO "production" libera
# destinatários originais. Ausente, "pilot", vazio ou qualquer outro
# valor mantém o modo piloto ativo.
#
# Em modo piloto, ACC_PILOT_RECIPIENT precisa ser exatamente
# crm@axion.com.br — ausente, inválido ou diferente bloqueia o
# envio inteiro (nenhuma mensagem sai, nem para o destinatário
# piloto). To é reescrito para esse endereço, CC/BCC/Reply-To ficam
# vazios, e o assunto recebe o prefixo "[TESTE CONTROLADO] ". O
# destinatário originalmente pretendido nunca aparece em nenhum
# header — continua preservado apenas em auditoria/metadados
# (public.emails.to_address e equivalentes), exatamente como hoje.
#
# Sem desligamento automático por data/relógio — a remoção é sempre
# manual, por configuração + novo deploy.
#
# ACC_OUTBOUND_MODE=pilot
# ACC_PILOT_RECIPIENT=crm@axion.com.br

# ACC_PILOT_ADDITIONAL_RECIPIENTS
# Mantida apenas por compatibilidade de ambiente. Durante o piloto
# operacional todos os e-mails são redirecionados exclusivamente para
# crm@axion.com.br; destinatários adicionais não são liberados.

# ACC_RISK_ALERTS_CRON_SECRET (server-only) — segredo DEDICADO do ciclo de
# alertas de risco (/api/cron/risk-alerts), enviado pelo workflow GitHub
# em Authorization: Bearer. Independente do CRON_SECRET usado pelos crons
# Vercel (weekly-alert-digest / system-health); sem fallback entre eles.
# ACC_RISK_ALERTS_CRON_SECRET=

# GOOGLE_GMAIL_INBOUND_MAILBOX (server-only) — caixa inbound OFICIAL do ACC.
# Já usada pelos workers GitHub (ingestão/respostas). Para os ALERTAS DE
# RISCO precisa existir TAMBÉM no ambiente do worker Vercel: é a única
# caixa admitida no Reply-To opaco (<caixa>+alerta-<token>@<domínio>);
# sem ela nenhum alerta real é enviado (REPLY_MAILBOX_NOT_CONFIGURED).
# GOOGLE_GMAIL_INBOUND_MAILBOX=

# ACC_WEEKLY_REPORTS_ENABLED (server-only — nunca NEXT_PUBLIC_*)
#
# Trava de deployment das funcionalidades de RELATÓRIOS SEMANAIS:
# registro documental por e-mail (aba "Registro por e-mail" e páginas
# /documentos/emails/...), ingestão automática do cronograma .mpp,
# leitura da planilha Excel do relatório semanal (Curva S, Linha de
# Base, Financeiro, Histograma, SSMA), dashboard /financeiro, telas de
# revisão humana/linha de base e o workflow horário
# weekly-schedule-email-ingestion (variável de repositório homônima).
#
# Essas funcionalidades dependem da migration
# supabase/migrations/20260920120000_weekly_schedule_email_ingestion_foundation.sql.
# Com a flag desligada NENHUMA tabela/função nova é consultada: menu e
# aba somem, as rotas novas mostram estado controlado ou 404, actions
# recusam e o worker encerra sem tocar no banco. As páginas antigas
# continuam funcionando normalmente.
#
# Regra fail-closed: somente o valor EXATO "true" habilita. Ausente,
# vazio, "false", "1", "TRUE" ou qualquer outro valor mantém desligado.
# Ligar apenas DEPOIS de aplicar a migration no banco do ambiente.
#
# ACC_WEEKLY_REPORTS_ENABLED=false

# CONSTRUMANAGER_LOGIN / CONSTRUMANAGER_PASSWORD / CONSTRUMANAGER_BASE_URL
# (server-only — nunca NEXT_PUBLIC_*, nunca expostas ao navegador,
# nunca persistidas em nenhuma tabela)
#
# Credenciais da API do Construmanager (api.construmanager.com.br),
# usadas somente em Server Actions/jobs server-side
# (lib/integrations/construmanager/client.ts). CONSTRUMANAGER_BASE_URL
# é opcional e precisa ser HTTPS quando definida; sem ela, usa o
# domínio oficial acima como padrão.
#
# CONSTRUMANAGER_LOGIN=usuario@empresa.com.br
# CONSTRUMANAGER_PASSWORD=troque-por-uma-senha-real
# CONSTRUMANAGER_BASE_URL=https://api.construmanager.com.br

# WhatsApp (SIMULADO — não existe provedor real). Desativado por padrão; só com "true" exato. Escopo: alerta CRITICO que chega a DIRETORIA.
ACC_WHATSAPP_ENABLED=false
ACC_WHATSAPP_PROVIDER=simulated

# AXIA — voz via ElevenLabs. DESATIVADA por padrão (fail-closed): sem ELEVENLABS_ENABLED="true", sem chave e sem ao menos uma voz
# autorizada não há chamada de rede e a resposta em texto continua. Variáveis somente do servidor; NUNCA coloque a chave em arquivo
# versionado nem no frontend (cadastre-a como variável sensível no provedor de deploy). Ver docs/vera-voz-elevenlabs.md.
# ELEVENLABS_ENABLED=false
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_IDS=                # lista autorizada, separada por vírgula (a primeira é a padrão)
# ELEVENLABS_DEFAULT_VOICE_ID=         # opcional; precisa estar em ELEVENLABS_VOICE_IDS
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5  # alternativas aceitas: eleven_turbo_v2_5, eleven_multilingual_v2
# ELEVENLABS_CREDIT_RESERVE=2000       # recusa a leitura se os créditos restantes < caracteres + reserva
# ELEVENLABS_MODE=                     # "simulado" só para testes locais (nenhuma chamada real)

# Perfil de e-mail do PROJETO PILOTO (server-only; ver docs/piloto-projeto-email.md). Sem ACC_PROJECT_PILOT_PROJECT_ID nada muda.
# Com ele, TODA mensagem daquele projeto sai de ACC_PROJECT_PILOT_SENDER e vai só para ACC_PROJECT_PILOT_DESTINATION (sem CC/BCC),
# identificada como PILOTO. Os endereços aceitos são uma lista fixa no código; o id é conferido por scripts/resolve-pilot-project.mjs.
# ACC_PROJECT_PILOT_PROJECT_ID=
# ACC_PROJECT_PILOT_DESTINATION=
# ACC_PROJECT_PILOT_SENDER=
# Remetente: se GOOGLE_GMAIL_SENDER_EMAIL já for o remetente do piloto (mesma conta autenticada), nada mais é necessário. Senão, identidade
# OAuth própria de quem realmente envia como ele (sem ela, a mensagem do piloto NÃO sai; sem fallback e sem trocar só o From):
# GOOGLE_GMAIL_PILOT_SENDER_EMAIL=
# GOOGLE_GMAIL_PILOT_REFRESH_TOKEN=
# Respostas: o Reply-To dos alertas usa GOOGLE_GMAIL_INBOUND_MAILBOX; essa caixa precisa ser a que a fase de respostas lê com
# ACC_RISK_ALERTS_INBOUND_* (ver docs/piloto-projeto-email.md). ACC_EMAIL_ONLY_RECIPIENT não precisa ser alterado: o piloto tem destino próprio.

# AXIA - conversa natural (camada de IA). Desligada por padrao: sem esta variavel a AXIA usa so a base aprovada.
# off | simulated (so fora da Vercel) | anthropic (exige ANTHROPIC_API_KEY e AXIA_CHAT_MODEL)
AXIA_CHAT_PROVIDER=off
AXIA_CHAT_MODEL=
# Teto de gasto GLOBAL da IA da AXIA (Postgres; exige a migration 20261105150000) e limite diario por usuario.
AXIA_CHAT_DAILY_BUDGET_USD=1
AXIA_CHAT_USER_DAILY_CALLS=100
