# TEMPLATE de variáveis do app de HOMOLOGAÇÃO (acc-homolog). Somente NOMES e placeholders. NÃO contém valores.
# Copie para um arquivo FORA do repositório (ex.: C:\VIBE\axion-homolog-secrets\.env.homolog) e preencha com os dados do projeto acc-homolog.
# NUNCA use valores do Supabase operacional nem das integrações reais. Validar: node scripts/homolog/check-env.mjs --file=<arquivo>

# --- OBRIGATÓRIAS (Supabase do acc-homolog: painel > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref-acc-homolog>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<chave publicavel do acc-homolog>
SUPABASE_SECRET_KEY=<chave secreta do acc-homolog; server-only; nunca NEXT_PUBLIC_>
AXION_APP_BASE_URL=<http://localhost:3000 ou URL do projeto Vercel de homologacao>

